<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Juribi.Models"
             x:Class="Juribi.Views.JobApplicationEditPage"
             Title="New Job Application">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Validation errors -->
            <Border IsVisible="{Binding HasErrors}"
                    BackgroundColor="#FDECEA"
                    Stroke="#D32F2F"
                    StrokeThickness="1"
                    Padding="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Please fix the following before saving:"
                           FontAttributes="Bold"
                           TextColor="#B71C1C" />
                    <CollectionView ItemsSource="{Binding Errors}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}" TextColor="#B71C1C" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="4">
                <Label Text="Job name" FontAttributes="Bold" FontSize="13" TextColor="Gray" />
                <Entry Text="{Binding JobName}" Placeholder="e.g. Senior .NET Developer" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Company" FontAttributes="Bold" FontSize="13" TextColor="Gray" />
                <Entry Text="{Binding Company}" Placeholder="e.g. Contoso" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Salary" FontAttributes="Bold" FontSize="13" TextColor="Gray" />
                <Entry Text="{Binding Salary}" Placeholder="e.g. €70,000 / year" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Status" FontAttributes="Bold" FontSize="13" TextColor="Gray" />
                <Picker ItemsSource="{Binding Statuses}"
                        SelectedItem="{Binding SelectedStatus}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Job link (optional)" FontAttributes="Bold" FontSize="13" TextColor="Gray" />
                <Entry Text="{Binding JobUrl}"
                       Keyboard="Url"
                       Placeholder="https://example.com/jobs/..." />
            </VerticalStackLayout>

            <Button Text="Save"
                    Command="{Binding SaveCommand}"
                    HorizontalOptions="Fill"
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
