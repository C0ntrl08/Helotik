<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Juribi.Models"
             x:Class="Juribi.MainPageView"
             Title="Job Applications">

    <Grid RowDefinitions="Auto,*">

        <!-- Column headers -->
        <Grid Grid.Row="0"
              Padding="15,10"
              ColumnSpacing="10"
              BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A2A2A}"
              ColumnDefinitions="2*,2*,2*,1.2*,0.6*">
            <Label Grid.Column="0" Text="Job" FontAttributes="Bold" />
            <Label Grid.Column="1" Text="Company" FontAttributes="Bold" />
            <Label Grid.Column="2" Text="Salary" FontAttributes="Bold" />
            <Label Grid.Column="3" Text="Status" FontAttributes="Bold" />
            <Label Grid.Column="4" Text="Link" FontAttributes="Bold" HorizontalTextAlignment="Center" />
        </Grid>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Entries}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No job applications yet."
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="0,40,0,0" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:JobApplication">
                    <Grid Padding="15,12"
                          ColumnSpacing="10"
                          ColumnDefinitions="2*,2*,2*,1.2*,0.6*">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <Label Grid.Column="0" Text="{Binding JobName}" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="1" Text="{Binding Company}" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="2" Text="{Binding Salary}" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="3" Text="{Binding Status}" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="4"
                               Text="&#128279;"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding JobUrl, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

                        <!-- Invalid entry marker -->
                        <BoxView Grid.Column="0"
                                 Grid.ColumnSpan="5"
                                 HeightRequest="2"
                                 VerticalOptions="End"
                                 Color="#D32F2F"
                                 IsVisible="{Binding IsValid, Converter={StaticResource InvertedBoolConverter}}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
